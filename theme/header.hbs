<!-- markdown-quiz head -->
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" rel="stylesheet">
<style>
    #check-questions {
        background-color: #28a745;
        border-color: #28a745;
        padding: .5rem 1rem;
        font-size: 1.25rem;
        line-height: 1.5;
        border-radius: .3rem;

    }
    #reset-questions {
        background-color: transparent;
        border: 1px solid transparent;
        color: #007bff;
        text-decoration: none;
    }
    ul {
        list-style-type: none;
    }
    ul.textbox > li > input {
        width: 80%;
        font-size: 0.95em;
        margin: 0.75em 0;
        background-color: inherit;
    }
    html body {
        color: inherit;
    }
    #check-questions {
        display: block;
        margin: 0.5em auto;
        min-width: 45%;
        font-size: 1em;
        opacity: 0.5;
        transition: 0.5s;
    }
    #check-questions:hover {
        opacity: 1
    }
    /*Remove reset button because it deletes the user's answers*/
    #reset-questions {
        display: none;
    }
</style>
<script src="https://code.jquery.com/jquery-3.4.1.min.js"
    integrity="sha256-CSXorXvZcTkaix6Yvo6HppcZGetbYMGWSFlBw8HfCJo="
    crossorigin="anonymous">
</script>

<!-- Check answers when enter button is pressed -->
<script>
    document.addEventListener("keydown", function(event) {
        if (event.key === "Enter") {
        document.getElementById("check-questions").click();
        }
    });
</script>